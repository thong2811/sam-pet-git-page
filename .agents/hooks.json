{
  "build-verifier": {
    "enabled": false,
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "npm run build",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "git-safety-gate": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/git-safety.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
